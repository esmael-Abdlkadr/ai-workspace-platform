{
  "name": "@workspace/rag",
  "version": "0.0.0",
  "private": true,
  "description": "RAG pipeline: document ingestion, chunking, embedding, and semantic retrieval",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
