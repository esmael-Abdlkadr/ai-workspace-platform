{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "description": "Supabase client, schema types, and logger utility",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./logger": {
      "import": "./dist/logger.js",
      "types": "./dist/logger.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "pino-pretty": "^11.3.0",
    "typescript": "^5.5.4"
  }
}
