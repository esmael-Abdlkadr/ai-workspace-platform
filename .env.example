# ============================================================
# AI Workspace Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ---- OpenAI -----------------------------------------------
# Used for LLM calls (GPT-4o) and embeddings (ada-002)
OPENAI_API_KEY=sk-...

# ---- Supabase ---------------------------------------------
# Public URL and anon key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key — NEVER expose this in the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- Notion -----------------------------------------------
# Integration token from https://www.notion.so/my-integrations
NOTION_API_KEY=secret_...

# The ID of the Notion database where outputs will be written
NOTION_DEFAULT_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---- App --------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
